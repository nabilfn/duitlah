# Copy to .env and adjust as needed. Used by docker-compose.yml.

DB_NAME=duitlah
DB_USER=duitlah
DB_PASSWORD=duitlah

# S3-compatible object storage for receipt images (MinIO locally). Fine to leave
# at these defaults for local dev; a real deployment points S3_ENDPOINT at an
# actual AWS S3 / Supabase Storage endpoint with real credentials instead.
S3_ACCESS_KEY=duitlah
S3_SECRET_KEY=duitlah-dev-secret

# Optional. Leave blank to run with OCR and the AI assistant both disabled --
# receipt scans open straight into the manual-entry review form, and the AI
# assistant returns a fixed "not configured" reply. Set a real key to enable
# both: Claude-vision-based receipt parsing (see
# apps/api/.../receipts/ClaudeVisionOcrService) and the AI financial assistant
# (see apps/api/.../ai/ClaudeAiChatService). Same key powers both features.
ANTHROPIC_API_KEY=
