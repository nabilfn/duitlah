# Reference for the environment variables application.yml reads.
# When running via docker-compose these are set in docker-compose.yml;
# this file is for running the api container standalone.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=duitlah
DB_USER=duitlah
DB_PASSWORD=duitlah
REDIS_HOST=redis
REDIS_PORT=6379
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Auth (see docs/security.md). The values below are dev-only defaults
# already baked into application.yml — this file exists to document what
# a real deployment MUST override, not because these are required locally.
# JWT_SECRET=$(openssl rand -base64 48)
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=30
# REFRESH_COOKIE_SAME_SITE=Lax
# REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_DOMAIN=
